{"ast":null,"code":"export function sortArtistsByAlbumCount(artists){return[...artists].sort((left,right)=>{if((right.albumCount||0)!==(left.albumCount||0)){return(right.albumCount||0)-(left.albumCount||0);}if(right.trackCount!==left.trackCount){return right.trackCount-left.trackCount;}return left.artist.localeCompare(right.artist);});}export function buildChartData(stats){if(!stats){return{artists:[],albums:[],artistsByAlbumCount:[],genres:[],years:[]};}return{artists:stats.artists.slice(0,10),artistsByAlbumCount:sortArtistsByAlbumCount(stats.artists).slice(0,10),albums:stats.albums.slice(0,10),genres:stats.genres.slice(0,10),years:[...stats.years].sort((left,right)=>right.trackCount-left.trackCount).slice(0,10)};}","map":{"version":3,"names":["sortArtistsByAlbumCount","artists","sort","left","right","albumCount","trackCount","artist","localeCompare","buildChartData","stats","albums","artistsByAlbumCount","genres","years","slice"],"sources":["/home/runner/work/MusicStats/MusicStats/src/client/src/chartData.js"],"sourcesContent":["export function sortArtistsByAlbumCount(artists) {\n  return [...artists].sort((left, right) => {\n    if ((right.albumCount || 0) !== (left.albumCount || 0)) {\n      return (right.albumCount || 0) - (left.albumCount || 0);\n    }\n\n    if (right.trackCount !== left.trackCount) {\n      return right.trackCount - left.trackCount;\n    }\n\n    return left.artist.localeCompare(right.artist);\n  });\n}\n\nexport function buildChartData(stats) {\n  if (!stats) {\n    return { artists: [], albums: [], artistsByAlbumCount: [], genres: [], years: [] };\n  }\n\n  return {\n    artists: stats.artists.slice(0, 10),\n    artistsByAlbumCount: sortArtistsByAlbumCount(stats.artists).slice(0, 10),\n    albums: stats.albums.slice(0, 10),\n    genres: stats.genres.slice(0, 10),\n    years: [...stats.years].sort((left, right) => right.trackCount - left.trackCount).slice(0, 10)\n  };\n}\n"],"mappings":"AAAA,MAAO,SAAS,CAAAA,uBAAuBA,CAACC,OAAO,CAAE,CAC/C,MAA